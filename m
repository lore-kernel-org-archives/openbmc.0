index 66691fa..f35f4dc 100755
--- a/bin/Barreleye.py
+++ b/bin/Barreleye.py
@@ -146,6 +146,12 @@ APPS = {
                 'monitor_process' : True,
                 'process_name'    : 'button_reset.exe',
